// Version information for Renegades.dll (Explorer's Details tab), in the style of OPU's modules. The version is the
// release's, as the loader's and the missions' (a version bump changes it here too).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,11,0
 PRODUCTVERSION 1,2,11,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Outpost Universe"
            VALUE "FileDescription", "Outpost 2 Module"
            VALUE "FileVersion", "1.2.11.0"
            VALUE "InternalName", "Renegades"
            VALUE "LegalCopyright", "Outpost Universe"
            VALUE "OriginalFilename", "Renegades.dll"
            VALUE "ProductName", "Outpost 2"
            VALUE "ProductVersion", "1.2.11.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
